# Dependencies
node_modules/
server/node_modules/
client/node_modules/

# Build output
client/dist/
.vercel/

# Prisma 7 generated client (dibangun ulang oleh `prisma generate` saat install/build)
server/src/generated/

# Bundel serverless (dibangun ulang oleh `npm run build:api --prefix server` saat build)
server/.build/

# Environment (semua varian .env diabaikan; hanya *.env.example yang boleh di-commit)
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example
client/.env
client/.env.*
!client/.env.example
.env.local
*.env.backup

# Uploads lokal (di Vercel memakai Cloudinary)
server/src/uploads/*
!server/src/uploads/.gitkeep

# Artefak E2E (screenshot & file bukti yang dibuat e2e.js saat run)
client/e2e/shots/
client/e2e/proof.png

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Database lokal
server/prisma/*.db
server/prisma/*.db-journal

package.json.backup
