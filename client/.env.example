# ============================================================================
# Template variabel build client. Salin jadi `client/.env` bila perlu override.
# ============================================================================

# Base URL backend (tanpa trailing slash).
# Dipakai oleh client/src/services/config.js.
#
# - Deploy single-project di Vercel (client + API satu domain):
#   biarkan KOSONG — request jadi same-origin ke `/api/...`.
# - Backend terpisah domain:
#   VITE_API_URL=https://api-domain-kamu.com
# - Development: TIDAK perlu diisi — Vite mem-proxy /api ke localhost:5000.
VITE_API_URL=

# Socket.io realtime:
# - development: aktif otomatis (server lokal mendukung WebSocket)
# - production (Vercel serverless): MATI otomatis — notifikasi tetap jalan
#   lewat Web Push + polling 30 detik
# - set `true` hanya bila backend pindah ke hosting yang mendukung WebSocket
VITE_ENABLE_SOCKET=
