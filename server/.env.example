cat > server/.env << 'EOF'
# ============ APP ============
NODE_ENV=development
PORT=5000
APP_NAME=Tabunganku Umroh
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ============ DATABASE ============
DATABASE_URL="postgresql://postgres:password@localhost:5432/tabunganku_umroh?schema=public"

# ============ JWT ============
JWT_ACCESS_SECRET=ganti_dengan_random_string_panjang_minimal_32_karakter_abc123
JWT_REFRESH_SECRET=ganti_dengan_random_string_lain_yang_berbeda_xyz789
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ============ CLOUDINARY ============
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============ EMAIL ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_app_password

# ============ WHATSAPP (FONNTE) ============
FONNTE_API_KEY=your_fonnte_api_key
FONNTE_SENDER=6281234567890

# ============ ADMIN DEFAULT ============
ADMIN_EMAIL=admin@tabunganku.com
ADMIN_PASSWORD=Admin@123456
EOF

echo "✅ server/.env berhasil dibuat"