# ============================================================================
# Template konfigurasi backend. Salin jadi `server/.env` lalu isi nilainya.
#
#   cp server/.env.example server/.env
#
# File ini HANYA berisi placeholder — jangan pernah menulis kredensial asli
# atau password default di sini karena berkas ini ikut ter-commit ke git.
#
# DEPLOY VERCEL: variabel di bawah yang bertanda [WAJIB] diset di
# Project Settings → Environment Variables (Production).
# ============================================================================

# ============ APP ============
NODE_ENV=development
PORT=5000
APP_NAME=Tabunganku Umroh
APP_URL=http://localhost:5000

# Origin frontend yang diizinkan CORS. Boleh lebih dari satu, pisahkan koma.
# Deploy single-project (client + API satu domain) boleh dikosongkan.
# Isi bila frontend di-host di domain terpisah, contoh:
# FRONTEND_URL=https://tabunganku.vercel.app,https://www.tabunganku.id
FRONTEND_URL=http://localhost:5173

# ============ DATABASE [WAJIB] ============
# Postgres hosted (Neon/Supabase/Vercel Postgres). Untuk serverless, sebaiknya
# pakai connection string POOLED (PgBouncer) + connection_limit kecil:
#   ...?pgbouncer=true&connection_limit=5
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tabunganku_umroh?schema=public"

# ============ JWT [WAJIB] ============
# Minimal 32 karakter dan WAJIB berbeda satu sama lain.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ============ CLOUDINARY [WAJIB di Vercel] ============
# Upload bukti transfer/KTP/paspor di serverless wajib Cloudinary.
# Tanpa ini, mode disk lokal dipakai (tidak akan jalan di Vercel).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============ EMAIL (SMTP) ============
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ============ WHATSAPP (FONNTE) ============
FONNTE_API_KEY=
FONNTE_SENDER=

# ============ WEB PUSH (VAPID) ============
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ============ ADMIN SEED ============
# Dipakai oleh `npm run db:seed`. Password minimal 12 karakter.
# Kalau dikosongkan, seed akan membuat password acak dan menampilkannya sekali.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
